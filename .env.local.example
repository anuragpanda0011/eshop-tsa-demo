###############################################################################
# LOCAL DEVELOPMENT SECRETS — copy to .env.local and fill in values.
# .env.local is in .gitignore and must NEVER be committed.
###############################################################################

# SQL Server SA password (used by both local SQL containers)
SQL_SA_PASSWORD=YourStr0ngP@ssw0rd!

# JWT secret — min 32 chars for HS256
Auth__JwtSecret=local-dev-jwt-secret-must-be-at-least-32-chars

# Redis — no TLS in local dev (DEBUG=true bypasses the TLS check)
Redis__ConnectionString=redis:6379

# CORS — local frontend origins
CORS_ORIGINS=http://localhost:5100,http://localhost:5200

# Allowed hosts
AllowedHosts=localhost;127.0.0.1

# Azure Storage (Azurite emulator — no real credentials needed)
AzureStorage__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KbHT8qL/3;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1

# Application Insights (leave blank locally — SDK no-ops when missing)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Service Bus (leave blank locally — in-process fallback used)
ServiceBus__ConnectionString=
ServiceBus__OrderQueueName=order-events

# Feature flags
LOG_LEVEL=Debug
PAGE_SIZE=10
JWT_ALGORITHM=HS256
DEBUG=true
