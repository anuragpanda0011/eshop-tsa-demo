###############################################################################
# eShopOnWeb — .gitignore
###############################################################################

# ── Secrets & certificates ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12
secrets/

# ── Build artefacts ───────────────────────────────────────────────────────────
**/bin/
**/obj/
**/out/
**/publish/

# ── .NET specifics ────────────────────────────────────────────────────────────
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.DotSettings.user
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
*.trx
*.coveragexml
*.coverage

# ── Node / front-end ──────────────────────────────────────────────────────────
node_modules/
dist/
build/
.parcel-cache/
.next/
.nuxt/

# ── Python (tooling) ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# ── IaC state ─────────────────────────────────────────────────────────────────
terraform.tfstate
terraform.tfstate.backup
*.tfvars
.terraform/
infra/.terraform/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Azure Developer CLI ───────────────────────────────────────────────────────
.azure/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
